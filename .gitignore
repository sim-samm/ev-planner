# macOS / editor clutter
.DS_Store
.AppleDouble
.LSOverride
._*
*.swp
*.swo
*~

# Cursor / VS Code local workspace state
.cursor/
.vscode/

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Virtual environments
.venv/
venv/
env/
ENV/

# Build / distribution artifacts
build/
dist/
*.egg-info/

# Logs and temp files
*.log
*.tmp
*.temp

# Generated document artifacts (from scripts/md2pdf.sh)
pdfs/*.pdf
*.aux
*.fdb_latexmk
*.fls
*.lof
*.lot
*.out
*.toc
*.synctex.gz

# Local reference checkouts (keep folder, ignore contents/symlinks)
references/*
!references/.gitkeep
